# ====================================================================
# EduSwap Telegram Bot - Configuration Environment Template
# Copy this file to .env and fill in your actual credentials.
# ====================================================================

# [1] Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# [2] SuperAdmin Telegram User IDs (comma-separated list of numeric IDs)
ADMIN_IDS=123456789,987654321

# [3] Telethon MTProto Client Credentials (from https://my.telegram.org)
# Required for scanning real-time eye-icon views on private channel posts.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# [4] Support & Scanner Usernames (without @)
SCANNER_USERNAME=your_scanner_account_username
SUPPORT_USERNAME=your_support_username

# [5] Privacy Gate (Teacher Only)
# If true, new users must apply and be approved by an Admin before accessing the bot.
PRIVATE_MODE=true

# [6] Database Configuration (Async SQLite default, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///bot.db

# [7] Automated Schedulers & Cooldown Timers
# Matchmaking check interval in seconds (default: 60)
MATCHMAKING_INTERVAL_SECONDS=60

# Eye-icon view scanner check interval in seconds (default: 45)
SCANNER_INTERVAL_SECONDS=45

# Stale deal cleanup check interval in seconds (default: 300)
CLEANUP_INTERVAL_SECONDS=300

# Maximum deal lifetime in hours before auto-delete if view goal is not reached (default: 24)
DEAL_TIMEOUT_HOURS=24

# Free tier weekly swap quota (default: 3)
FREE_WEEKLY_SWAP_LIMIT=3

# Rest cooldown in days before the same two channels can swap again (default: 14)
SWAP_COOLDOWN_DAYS=14
